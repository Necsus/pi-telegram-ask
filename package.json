{
  "name": "@necsus/pi-telegram-ask",
  "version": "0.1.0",
  "description": "Pause Pi workflows for developer decisions over Telegram, with a local questionnaire fallback.",
  "type": "module",
  "license": "MIT",
  "author": "Necsus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Necsus/pi-telegram-ask.git"
  },
  "homepage": "https://github.com/Necsus/pi-telegram-ask#readme",
  "bugs": {
    "url": "https://github.com/Necsus/pi-telegram-ask/issues"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "telegram",
    "human-in-the-loop",
    "developer-tools"
  ],
  "files": [
    "extensions/index.ts",
    "extensions/telegram.ts",
    "config.example.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@juicesharp/rpiv-ask-user-question": "2.3.0"
  },
  "bundledDependencies": [
    "@juicesharp/rpiv-ask-user-question"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@types/node": "^24.0.0",
    "typebox": "1.3.8",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  }
}
